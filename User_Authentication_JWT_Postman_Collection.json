{
    "info": {
        "name": "User Authentication & JWT",
        "_postman_id": "user-auth-jwt-collection",
        "description": "Postman collection for testing registration, login, JWT protected profile, and logout.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Register",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\"name\": \"Reshma\", \"email\": \"reshma@test.com\", \"password\": \"Test1234\"}"
                },
                "url": {
                    "raw": "http://localhost:8000/api/auth/register",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "8000",
                    "path": [
                        "api",
                        "auth",
                        "register"
                    ]
                }
            }
        },
        {
            "name": "Login",
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\"email\": \"reshma@test.com\", \"password\": \"Test1234\"}"
                },
                "url": {
                    "raw": "http://localhost:8000/api/auth/login",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "8000",
                    "path": [
                        "api",
                        "auth",
                        "login"
                    ]
                }
            }
        },
        {
            "name": "Protected Profile",
            "request": {
                "method": "GET",
                "url": {
                    "raw": "http://localhost:8000/api/profile",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "8000",
                    "path": [
                        "api",
                        "profile"
                    ]
                }
            }
        },
        {
            "name": "Logout",
            "request": {
                "method": "POST",
                "url": {
                    "raw": "http://localhost:8000/api/auth/logout",
                    "protocol": "http",
                    "host": [
                        "localhost"
                    ],
                    "port": "8000",
                    "path": [
                        "api",
                        "auth",
                        "logout"
                    ]
                }
            }
        }
    ]
}
